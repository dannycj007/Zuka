# Supabase project settings > Database > Connection string
# Used by the Supabase CLI / migration tooling, not by the app at runtime.
SUPABASE_DB_URL=

# Only used by `npm run seed:demo`. The email you signed up with in the
# app — the demo event gets attached to that account's organisation.
# Can also be passed as an argument instead: npm run seed:demo -- you@example.com
SEED_ORG_OWNER_EMAIL=

# Optional. Set in production so email-confirmation links point at the
# right domain. Falls back to the request's own host in development.
NEXT_PUBLIC_SITE_URL=

# --- Added in later phases, not needed yet --------------------------------

# NextSMS (Phase 4) — nextsms.co.tz account. Sender ID ZUKA may still be
# pending approval; the delivery layer must handle that gracefully.
NEXTSMS_API_KEY=
NEXTSMS_SENDER_ID=ZUKA

# Inngest (Phase 4) — app.inngest.com project keys
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Google Sheets mirror (Phase 6) — GCP service account for a one-way push.
# Share your sheet with GOOGLE_SERVICE_ACCOUNT_EMAIL as Editor.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Sentry (Phase 7)
SENTRY_DSN=
