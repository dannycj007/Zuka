# Copy this file to .env and fill in real values. Never commit .env.
# See README.md for exactly where to get each of these.

# --- Needed for Phase 1 ---------------------------------------------------

# Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase project settings > API (service_role key — server-only, bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=

# Supabase project settings > Database > Connection string
# Used by the Supabase CLI / migration tooling, not by the app at runtime.
SUPABASE_DB_URL=

# Only used by `npm run seed:demo`. The email you signed up with in the
# app — the demo event gets attached to that account's organisation.
# Can also be passed as an argument instead: npm run seed:demo -- you@example.com
SEED_ORG_OWNER_EMAIL=

# Optional in Phase 1-3 (falls back to the request's own host), but
# REQUIRED from Phase 4 on: the background send job has no incoming
# request to infer a host from, so without this, invite links in SMS
# messages can't be built at all and sends will fail with a clear
# "NEXT_PUBLIC_SITE_URL is not configured" error.
NEXT_PUBLIC_SITE_URL=

# --- Needed for Phase 4 ----------------------------------------------------

# NextSMS (nextsms.co.tz account) — Settings > API in your dashboard.
# Sender ID ZUKA may still be pending approval; the delivery layer
# handles that gracefully (logs a failed delivery_events row with the
# reason, doesn't crash the send).
NEXTSMS_API_KEY=
NEXTSMS_SENDER_ID=ZUKA

# Inngest (app.inngest.com) — Settings > Keys on your Inngest app, once
# you've created one and pointed it at this deployment's
# /api/inngest endpoint. Local dev can run without these via
# `npx inngest-cli@latest dev` (see README).
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Google Sheets mirror (Phase 6) — GCP service account for a one-way push.
# Share your sheet with GOOGLE_SERVICE_ACCOUNT_EMAIL as Editor.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Sentry (Phase 7)
SENTRY_DSN=
