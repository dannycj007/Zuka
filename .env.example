# Copy this file to .env and fill in real values. Never commit .env.
# See README.md for exactly where to get each of these.

# --- Needed for Phase 1 ---------------------------------------------------

# Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase project settings > API (service_role key — server-only, bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=

# Supabase project settings > Database > Connection string
# Used by the Supabase CLI / migration tooling, not by the app at runtime.
SUPABASE_DB_URL=

# Only used by `npm run seed:demo`. The email you signed up with in the
# app — the demo event gets attached to that account's organisation.
# Can also be passed as an argument instead: npm run seed:demo -- you@example.com
SEED_ORG_OWNER_EMAIL=

# Required from Phase 4 on: when an organiser clicks "Send", the app
# builds the guest's invite URL to put in the SMS text. Without this set,
# sending fails with a clear "NEXT_PUBLIC_SITE_URL is not configured"
# error rather than sending a broken link.
NEXT_PUBLIC_SITE_URL=

# --- Needed for Phase 4, but NOT as env vars here — see README's
# "Delivery (Phase 4)" section ---------------------------------------------
#
# NextSMS's API key does not go in .env or Vercel: the actual HTTP call
# to NextSMS happens from Postgres (pg_net + pg_cron), not from this app,
# so the key lives in Supabase Vault instead. One-time setup, run once in
# the SQL Editor after applying 0004_send_jobs_pg_cron.sql:
#
#   select vault.create_secret('<your NextSMS API key>', 'nextsms_api_key');
#
# The sender ID (ZUKA) is hardcoded in that same migration rather than
# configurable — change it there directly if it ever needs to change.

# Google Sheets mirror (Phase 6) — GCP service account for a one-way push.
# Share your sheet with GOOGLE_SERVICE_ACCOUNT_EMAIL as Editor.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Sentry (Phase 7)
SENTRY_DSN=
