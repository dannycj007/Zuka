# Copy this file to .env and fill in real values. Never commit .env.
# See README.md for exactly where to get each of these.

# --- Needed for Phase 1 ---------------------------------------------------

# Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase project settings > API (service_role key — server-only, bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=

# Supabase project settings > Database > Connection string
# Used by the Supabase CLI / migration tooling, not by the app at runtime.
SUPABASE_DB_URL=

# Only used by `npm run seed:demo`. The email of a user that already
# exists in auth.users (add one via the Supabase dashboard — see
# README's "Access control & roles" section) — the script creates a
# 'customer' profile and demo event assignment for that email.
# Can also be passed as an argument instead: npm run seed:demo -- you@example.com
SEED_ORG_OWNER_EMAIL=

# Required from Phase 4 on: when an organiser clicks "Send", the app
# builds the guest's invite URL to put in the SMS text. Without this set,
# sending fails with a clear "NEXT_PUBLIC_SITE_URL is not configured"
# error rather than sending a broken link.
NEXT_PUBLIC_SITE_URL=

# Required from Phase 4 on: the app calls HudumaSMS directly and
# synchronously from the server action when an organiser clicks
# "Send"/"Resend" (see README's "Delivery (Phase 4)" section). Get the
# key from huduma.cloud's dashboard: Developer > API Keys tab. Without
# this set, sending fails with a clear "HUDUMASMS_API_KEY is not
# configured" error rather than a broken call.
#
# Replaces NextSMS (decision 5.1's 2026-10-10 provider swap — see
# DECISIONS.md). NextSMS's sender ID never got approved despite weeks
# of live debugging; HudumaSMS's "ZUKAEVENTS" sender was Active
# immediately and the first real SMS in this project's history sent
# successfully through it on day one.
HUDUMASMS_API_KEY=

# Sender ID registered with HudumaSMS. Defaults to "ZUKAEVENTS". Only
# set this to override the default.
HUDUMASMS_SENDER_NAME=

# WhatsApp via Meta Cloud API (decision 5.2's 2026-09-29 addition — see
# DECISIONS.md and README's "WhatsApp (Meta Cloud API)" section for the
# full setup walkthrough, including the template text to submit for
# approval and real constraints on testing before Business Verification).
#
# From Meta Business Manager > System Users: create a system user, grant
# it access to your WhatsApp Business Account with whatsapp_business_messaging
# permission, generate a permanent (non-expiring) token.
WHATSAPP_ACCESS_TOKEN=
# From the app dashboard's WhatsApp > API Setup page — the numeric Phone
# Number ID, not the phone number itself.
WHATSAPP_PHONE_NUMBER_ID=
# The exact name of your approved message template (create it in Meta
# Business Manager > WhatsApp Manager > Message Templates). See README
# for the exact body text this app expects (3 variables: guest name,
# event name, invite link).
WHATSAPP_TEMPLATE_NAME=
# Optional — Graph API version to call. Defaults to v23.0 if unset.
WHATSAPP_API_VERSION=
# A secret you invent yourself (not provided by Meta) — put the same
# value in both here and the "Verify token" field on Meta's "Configure
# Webhooks" dashboard step, so /api/webhooks/whatsapp can confirm the
# verification handshake is really coming from Meta.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Google Sheets mirror (Phase 6) — GCP service account for a one-way push.
# Share your sheet with GOOGLE_SERVICE_ACCOUNT_EMAIL as Editor.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Sentry (Phase 7)
SENTRY_DSN=
